{
  "name": "@carriyo/react-pack-mule",
  "version": "2.0.1",
  "description": "Simple global state store",
  "author": "Munawwar",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Munawwar/react-pack-mule.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc",
    "build:js": "esbuild src/index.tsx --bundle --minify --sourcemap --external:react --external:zustand --format=esm --outfile=dist/index.js",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/public",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.0.0",
    "@vitest/ui": "^5.1.2",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "zustand": "^5.1.0"
  }
}
